# =========================================================
# THENGA ROYALE 👑 - Vercel & Supabase Environment Configuration
# =========================================================

# 1. Supabase PostgreSQL & Storage Configuration (Required for live DB)
# Replace with your actual Supabase Project URL and Public Anon Key from:
# https://supabase.com/dashboard/project/<your-project-id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# 2. Supabase Storage Bucket Name
# Matches the bucket created in your Supabase dashboard:
# Storage -> New Bucket -> Name: contestants (Public Bucket: ON)
NEXT_PUBLIC_SUPABASE_BUCKET=contestants

# 3. Optional: Supabase Service Role Key (for server-side admin writes)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 4. Production Application URL (Set automatically by Vercel in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
